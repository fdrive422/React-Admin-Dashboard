# Supabase (server-side). Get these from your Supabase project:
# Project Settings -> API -> Project URL and the service_role secret key.
# The service_role key bypasses RLS and must never be exposed to the client.
SUPABASE_URL=https://your-project-ref.supabase.co 
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS origin for the React client (optional; defaults to http://localhost:3000)
CLIENT_URL=http://localhost:3000

# Local dev server port (optional; defaults to 9000)
PORT=9000
